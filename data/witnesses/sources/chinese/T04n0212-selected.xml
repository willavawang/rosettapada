<text><body><cb:div type="pin"><cb:mulu level="1" n="3" type="品">3 愛品</cb:mulu><head><anchor type="circle"/><anchor xml:id="nkr_note_orig_0632009" n="0632009"/><anchor xml:id="nkr_note_mod_0632009" n="0632009"/>愛品第三</head>
<lg xml:id="selected-pali342-1" corresp="T212 3.6" type="selected-verse"><l><lb n="0633c02" ed="T"/>眾生愛纏裹，</l><l><lb n="0633c02" ed="T"/>猶兔在於罝，</l><l><lb n="0633c03" ed="T"/>為結使所纏，</l><l><lb n="0633c03" ed="T"/>數數受苦惱。</l></lg></cb:div><cb:div type="pin"><cb:mulu level="1" n="13" type="品">13 道品</cb:mulu><head><title><anchor xml:id="nkr_note_orig_0681006" n="0681006"/><anchor xml:id="nkr_note_mod_0681006" n="0681006"/><anchor xml:id="beg0681006" n="0681006"/>出曜經<anchor xml:id="end0681006"/></title>道品第十<anchor xml:id="nkr_note_orig_0681007" n="0681007"/><anchor xml:id="nkr_note_mod_0681007" n="0681007"/><anchor xml:id="beg0681007" n="0681007"/>三<anchor xml:id="end0681007"/></head>
<lg xml:id="selected-pali277-1" corresp="T212 13.5" type="selected-verse"><l><lb n="0682b19" ed="T"/>一切行無常，</l><l><lb n="0682b19" ed="T"/>如慧所觀見，</l><l><lb n="0682b20" ed="T"/>若能覺此苦，</l><l><lb n="0682b20" ed="T"/>行道淨其迹。</l></lg></cb:div><cb:div type="pin"><cb:mulu level="1" n="15" type="品">15 忿怒品</cb:mulu><head>忿怒品第十<anchor xml:id="nkr_note_orig_0693011" n="0693011"/><anchor xml:id="nkr_note_mod_0693011" n="0693011"/><anchor xml:id="beg0693011" n="0693011"/>五<anchor xml:id="end0693011"/></head>
<lg xml:id="selected-pali003-1" corresp="T212 15.7" type="selected-verse"><l><lb n="0696c24" ed="T"/>人若罵我，</l><l><lb n="0696c24" ed="T"/>勝我不勝，</l><l><lb n="0696c24" ed="T"/>快意從者，</l><l><lb n="0696c25" ed="T"/>怨終不息。</l></lg></cb:div><cb:div type="pin"><cb:mulu level="1" n="16" type="品">16 惟念品</cb:mulu><head><anchor xml:id="nkr_note_orig_0698003" n="0698003"/><anchor xml:id="nkr_note_mod_0698003" n="0698003"/>惟念品第十<anchor xml:id="nkr_note_orig_0698004" n="0698004"/><anchor xml:id="nkr_note_mod_0698004" n="0698004"/><anchor xml:id="beg0698004" n="0698004"/>六<anchor xml:id="end0698004"/></head>
<lg xml:id="selected-pali300-1" corresp="T212 16.18" type="selected-verse"><l><lb n="0701c26" ed="T"/>善覺自覺者，</l><l><lb n="0701c26" ed="T"/>是瞿曇弟子，</l><l><lb n="0701c27" ed="T"/>晝夜當念是，</l><l><lb n="0701c27" ed="T"/>一心念不害。</l></lg></cb:div><cb:div type="pin"><cb:mulu level="1" n="17" type="品">17 雜品</cb:mulu><head><title><anchor xml:id="nkr_note_orig_0702005" n="0702005"/><anchor xml:id="nkr_note_mod_0702005" n="0702005"/><anchor xml:id="beg0702005" n="0702005"/>出曜經<anchor xml:id="end0702005"/></title><anchor type="circle"/><anchor xml:id="nkr_note_orig_0702006" n="0702006"/><anchor xml:id="nkr_note_mod_0702006" n="0702006"/>雜品第十<anchor xml:id="nkr_note_orig_0702007" n="0702007"/><anchor xml:id="nkr_note_mod_0702007" n="0702007"/><anchor xml:id="beg0702007" n="0702007"/>七<anchor xml:id="end0702007"/></head>
<lg xml:id="selected-pali357-1" corresp="T212 17.15" type="selected-verse"><l><lb n="0705b24" ed="T"/>猶如穢惡田，</l><l><lb n="0705b24" ed="T"/>瞋恚滋蔓生，</l><l><lb n="0705b25" ed="T"/>是故當離恚，</l><l><lb n="0705b25" ed="T"/>施報無有量。</l></lg><lg xml:id="selected-pali358-1" corresp="T212 17.16" type="selected-verse"><l><lb n="0705c06" ed="T"/>猶如穢惡田，</l><l><lb n="0705c06" ed="T"/>愚癡穢惡生，</l><l><lb n="0705c07" ed="T"/>是故當離愚，</l><l><lb n="0705c07" ed="T"/>獲報無有量。</l></lg><lg xml:id="selected-pali359-1" corresp="T212 17.18" type="selected-verse"><l><lb n="0706a08" ed="T"/>猶如穢惡田，</l><l><lb n="0706a08" ed="T"/>貪欲為滋蔓，</l><l><lb n="0706a09" ed="T"/>是故當離貪，</l><l><lb n="0706a09" ed="T"/>獲報無有量。</l></lg></cb:div><cb:div type="pin"><cb:mulu level="1" n="19" type="品">19 華品</cb:mulu><head><anchor xml:id="nkr_note_orig_0708012" n="0708012"/><anchor xml:id="nkr_note_mod_0708012" n="0708012"/><anchor xml:id="beg0708012" n="0708012"/>華品<anchor xml:id="end0708012"/>第十<anchor xml:id="nkr_note_orig_0708013" n="0708013"/><anchor xml:id="nkr_note_mod_0708013" n="0708013"/><anchor xml:id="beg0708013" n="0708013"/>九<anchor xml:id="end0708013"/></head>
<lg xml:id="selected-pali285-1" corresp="T212 19.5" type="selected-verse"><l><lb n="0709a09" ed="T"/>當自斷戀，</l><l><lb n="0709a09" ed="T"/>如秋池華，</l><l><lb n="0709a09" ed="T"/>息跡受教，</l><l><lb n="0709a10" ed="T"/>佛說泥洹。</l></lg></cb:div><cb:div type="pin"><cb:mulu level="1" n="26" type="品">26 親品</cb:mulu><head><title><anchor xml:id="nkr_note_orig_0727013" n="0727013"/><anchor xml:id="nkr_note_mod_0727013" n="0727013"/><anchor xml:id="beg0727013" n="0727013"/>出曜經<anchor xml:id="end0727013"/></title>親品第二十<anchor xml:id="nkr_note_orig_0727014" n="0727014"/><anchor xml:id="nkr_note_mod_0727014" n="0727014"/><anchor xml:id="beg0727014" n="0727014"/>六<anchor xml:id="end0727014"/></head>
<lg xml:id="selected-pali208-1" corresp="T212 26.20" type="selected-verse"><l><lb n="0730b13" ed="T"/>是故事多聞，</l><l><lb n="0730b13" ed="T"/>并及持戒者，</l><l><lb n="0730b14" ed="T"/>如是人中上，</l><l><lb n="0730b14" ed="T"/>猶月在眾星。</l></lg></cb:div><cb:div type="pin"><cb:mulu level="1" n="28" type="品">28 觀品</cb:mulu><head>觀品第二十<anchor xml:id="nkr_note_orig_0736009" n="0736009"/><anchor xml:id="nkr_note_mod_0736009" n="0736009"/><anchor xml:id="beg0736009" n="0736009"/>八<anchor xml:id="end0736009"/></head>
<lg xml:id="selected-pali171-1" corresp="T212 28.14" type="selected-verse"><l><lb n="0738b12" ed="T"/>如是當觀身，</l><l><lb n="0738b12" ed="T"/>如王雜色車，</l><l><lb n="0738b13" ed="T"/>愚者所染著，</l><l><lb n="0738b13" ed="T"/>善求遠離彼。</l></lg><lg xml:id="selected-pali252-1" corresp="T212 28.1" type="selected-verse"><l><lb n="0736b06" ed="T"/>善觀己瑕隙，</l><l><lb n="0736b06" ed="T"/>使己不露外，</l><l><lb n="0736b07" ed="T"/>彼彼自有隙，</l><l><lb n="0736b07" ed="T"/>如彼飛輕塵。</l></lg><lg xml:id="selected-pali253-1" corresp="T212 28.2" type="selected-verse"><l><lb n="0736b12" ed="T"/>若己稱無瑕，</l><l><lb n="0736b12" ed="T"/>二事俱并至，</l><l><lb n="0736b13" ed="T"/>但見外人隙，</l><l><lb n="0736b13" ed="T"/>恒懷危害心，</l><l><lb n="0736b14" ed="T"/>遠觀不見近。</l></lg></cb:div><cb:div type="pin"><cb:mulu level="1" n="29" type="品">29 惡行品</cb:mulu><head><anchor type="circle"/><anchor xml:id="nkr_note_orig_0741010" n="0741010"/><anchor xml:id="nkr_note_mod_0741010" n="0741010"/>惡行品第二十<anchor xml:id="nkr_note_orig_0741011" n="0741011"/><anchor xml:id="nkr_note_mod_0741011" n="0741011"/><anchor xml:id="beg0741011" n="0741011"/>九<anchor xml:id="end0741011"/></head>
<lg xml:id="selected-pali205-1" corresp="T212 29.5" type="selected-verse"><l><lb n="0742c10" ed="T"/>解知念待味，</l><l><lb n="0742c10" ed="T"/>思惟休息義，</l><l><lb n="0742c11" ed="T"/>無熱無飢想，</l><l><lb n="0742c11" ed="T"/>當服於法味。</l></lg></cb:div><cb:div type="pin"><cb:mulu level="1" n="31" type="品">31 樂品</cb:mulu><head><anchor type="circle"/><anchor xml:id="nkr_note_orig_0753003" n="0753003"/><anchor xml:id="nkr_note_mod_0753003" n="0753003"/>樂品第三十<anchor xml:id="nkr_note_orig_0753004" n="0753004"/><anchor xml:id="nkr_note_mod_0753004" n="0753004"/><anchor xml:id="beg0753004" n="0753004"/>一<anchor xml:id="end0753004"/></head>
<lg xml:id="selected-pali131-1" corresp="T212 31.3" type="selected-verse"><l><lb n="0753b01" ed="T"/>善樂於愛欲，</l><l><lb n="0753b01" ed="T"/>以杖加群生，</l><l><lb n="0753b02" ed="T"/>於中自求安，</l><l><lb n="0753b02" ed="T"/>後世不得樂。</l></lg></cb:div><cb:div type="pin"><cb:mulu level="1" n="32" type="品">32 心意品</cb:mulu><head>心意品第三十<anchor xml:id="nkr_note_orig_0758015" n="0758015"/><anchor xml:id="nkr_note_mod_0758015" n="0758015"/><anchor xml:id="beg0758015" n="0758015"/>二<anchor xml:id="end0758015"/></head>
<lg xml:id="selected-pali034-1" corresp="T212 32.2" type="selected-verse"><l><lb n="0758c25" ed="T"/>如魚在旱地，</l><l><lb n="0758c25" ed="T"/>以離於深淵，</l><l><lb n="0758c26" ed="T"/>心識極惶懅，</l><l><lb n="0758c26" ed="T"/>魔眾而奔馳。</l></lg></cb:div><cb:div type="pin"><cb:mulu level="1" n="34" type="品">34 梵志品</cb:mulu><head><title><anchor type="circle"/><anchor xml:id="nkr_note_orig_0768006" n="0768006"/><anchor xml:id="nkr_note_mod_0768006" n="0768006"/>出曜經</title>梵志品第三十<anchor xml:id="nkr_note_orig_0768007" n="0768007"/><anchor xml:id="nkr_note_mod_0768007" n="0768007"/><anchor xml:id="beg0768007" n="0768007"/>四<anchor xml:id="end0768007"/></head>
<lg xml:id="selected-pali389-1" corresp="T212 34.62" type="selected-verse"><l><lb n="0774c25" ed="T"/>不捶梵志，</l><l><lb n="0774c25" ed="T"/>不放梵志，</l><l><lb n="0774c25" ed="T"/>咄捶梵志，</l><l><lb n="0774c26" ed="T"/>放者亦咄。</l></lg><lg xml:id="selected-pali390-1" corresp="T212 34.72" type="selected-verse"><l><lb n="0775c10" ed="T"/>梵志無有是，</l><l><lb n="0775c10" ed="T"/>有憂無憂念，</l><l><lb n="0775c11" ed="T"/>如如意所轉，</l><l><lb n="0775c11" ed="T"/>彼彼滅狐疑。</l></lg><lg xml:id="selected-pali410-1" corresp="T212 34.43" type="selected-verse"><l><lb n="0772c14" ed="T"/>人無希望，</l><l><lb n="0772c14" ed="T"/>今世後世，</l><l><lb n="0772c14" ed="T"/>以無希望，</l><l><lb n="0772c15" ed="T"/>是謂梵志。</l></lg><lg xml:id="selected-pali411-1" corresp="T212 34.54" type="selected-verse"><l><lb n="0774a08" ed="T"/>棄捐家居，</l><l><lb n="0774a08" ed="T"/>無家之畏，</l><l><lb n="0774a08" ed="T"/>逮甘露滅，</l><l><lb n="0774a09" ed="T"/>是謂梵志。</l></lg><lg xml:id="selected-pali415-1" corresp="T212 34.36" type="selected-verse"><l><lb n="0772a20" ed="T"/>若能棄欲，</l><l><lb n="0772a20" ed="T"/>去家捨愛，</l><l><lb n="0772a20" ed="T"/>以斷欲漏，</l><l><lb n="0772a21" ed="T"/>是謂梵志。</l></lg><lg xml:id="selected-pali419-1" corresp="T212 34.47" type="selected-verse"><l><lb n="0773a20" ed="T"/>自識於宿命，</l><l><lb n="0773a20" ed="T"/>知眾生因緣，</l><l><lb n="0773a21" ed="T"/>如來佛無著，</l><l><lb n="0773a21" ed="T"/>是謂為梵志。</l></lg></cb:div></body></text></TEI>